# Driver data: "mock" (tanpa backend) | "supabase" | "rest"
VITE_DATA_DRIVER=mock

# Jeda buatan driver mock dalam milidetik. Bawaan 0 (secepat mungkin).
# Setel mis. 300 kalau ingin menguji tampilan skeleton & keadaan memuat.
VITE_MOCK_JEDA_MS=0

# Identitas aplikasi
VITE_APP_NAME="Ozora Panel"

# --- Supabase (hanya anon key; JANGAN pernah taruh service_role di sini) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Driver REST (mis. backend Laravel) ---
VITE_API_BASE_URL=
