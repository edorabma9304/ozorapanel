/*
 * Worker Cloudflare untuk permainan Jelajah Dunia.
 *
 * Satu deploy, satu URL: berkas statis dari `dist-game/` plus API ruang di
 * `/api/*` yang dijalankan Durable Object. `run_worker_first` wajib ada —
 * tanpa itu `/api/*` ikut dilayani sebagai berkas statis dan tidak pernah
 * sampai ke Worker.
 *
 * Pakai:
 *   pnpm cf:dev      # runtime Cloudflare asli di komputer sendiri
 *   pnpm cf:deploy   # terbitkan (butuh `wrangler login` sekali)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jelajah-dunia",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist-game",
    "binding": "ASET",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RUANG", "class_name": "RuangPermainan" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RuangPermainan"] }]
}
